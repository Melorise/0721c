{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://0721c.dev/schemas/v1/settings.schema.json",
  "title": "Settings",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "default": 1
    },
    "articlePolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "open",
            "allowlist"
          ],
          "default": "open"
        },
        "disabledIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[\\p{L}\\p{N}_-][\\p{L}\\p{N}._-]*(?:/[\\p{L}\\p{N}_-][\\p{L}\\p{N}._-]*)*$",
            "minLength": 1,
            "maxLength": 512
          },
          "uniqueItems": true,
          "default": []
        }
      },
      "required": []
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "bodyCodepoints": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8000,
          "default": 8000
        },
        "bodyBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32768,
          "default": 32768
        },
        "maxReplyDepth": {
          "type": "integer",
          "minimum": 0,
          "maximum": 64,
          "default": 64
        }
      },
      "required": []
    },
    "locale": {
      "enum": [
        "zh-CN",
        "en"
      ],
      "default": "zh-CN"
    },
    "site": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "url": {
          "type": "string",
          "default": "",
          "pattern": "^(?:$|https?://[^?#]+$)"
        },
        "name": {
          "type": "string",
          "maxLength": 128,
          "default": ""
        }
      }
    },
    "notifications": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "from": {
          "type": "string",
          "maxLength": 320,
          "default": ""
        },
        "notifyOwner": {
          "type": "boolean",
          "default": true
        },
        "notifyReplies": {
          "type": "boolean",
          "default": true
        }
      }
    }
  },
  "required": [],
  "description": "Input settings may omit fields; validateSettings returns the canonical complete defaults and rejects unknown fields.",
  "allOf": [
    {
      "if": {
        "required": [
          "notifications"
        ],
        "properties": {
          "notifications": {
            "required": [
              "enabled"
            ],
            "properties": {
              "enabled": {
                "const": true
              }
            }
          }
        }
      },
      "then": {
        "required": [
          "site"
        ],
        "properties": {
          "site": {
            "required": [
              "url"
            ],
            "properties": {
              "url": {
                "minLength": 1
              }
            }
          },
          "notifications": {
            "required": [
              "from"
            ],
            "properties": {
              "from": {
                "minLength": 1
              }
            }
          }
        }
      }
    }
  ]
}
